{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "FlagDeck": "Information"
    }
  },
  "AllowedHosts": "*",
  "FlagDeck": {
    "DashboardTitle": "FlagDeck Sample",
    "DashboardSubtitle": "Reference application",
    "PathPrefix": "/_flagdeck",
    "DefaultTheme": "Dark",
    "AllowInProduction": false,
    "AllowedEnvironments": [ "Development", "Staging", "QA", "Test", "Local" ],
    "CookieMaxAge": "7.00:00:00"
  },
  "FeatureManagement": {
    "NewGreeting": false,
    "BetaUI": {
      "EnabledFor": [
        {
          "Name": "Percentage",
          "Parameters": { "Value": 25 }
        }
      ]
    },
    "HolidayBanner": {
      "EnabledFor": [
        {
          "Name": "TimeWindow",
          "Parameters": {
            "Start": "2026-12-15T00:00:00Z",
            "End": "2027-01-05T00:00:00Z"
          }
        }
      ]
    },
    "InternalTools": {
      "EnabledFor": [
        {
          "Name": "Microsoft.Targeting",
          "Parameters": {
            "Audience": {
              "Users": [],
              "Groups": [
                { "Name": "internal", "RolloutPercentage": 100 }
              ],
              "DefaultRolloutPercentage": 0
            }
          }
        }
      ]
    },
    "CheckoutExperience": {
      "Variants": [
        { "Name": "control",     "ConfigurationValue": "classic" },
        { "Name": "guided",      "ConfigurationValue": "guided"  },
        { "Name": "one-page",    "ConfigurationValue": "single"  }
      ],
      "Allocation": {
        "DefaultWhenEnabled": "control",
        "Percentile": [
          { "Variant": "control",  "From":  0, "To": 60 },
          { "Variant": "guided",   "From": 60, "To": 90 },
          { "Variant": "one-page", "From": 90, "To": 100 }
        ],
        "Seed": "checkout-2026"
      },
      "EnabledFor": [
        { "Name": "Percentage", "Parameters": { "Value": 100 } }
      ]
    },
    "ReportsApi": false,
    "MaintenanceMode": false,
    "OrdersV2": false
  }
}
